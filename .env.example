# ==============================================================================
# WRITELYNX PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Core Project
PROJECT_NAME="Writelynx"
ENVIRONMENT="development"  # Options: development | staging | production
SECRET_KEY="generate-a-secure-32-byte-hex-secret-in-production"
API_PREFIX="/api"
MAX_FILE_SIZE_MB=50
DOMAIN="writelynx.in"

# Database Configuration (PostgreSQL in production; SQLite in local dev)
DATABASE_URL="postgresql://writelynx:writelynx_pass@localhost:5432/writelynx_db"
POSTGRES_PASSWORD="writelynx_secure_pass"

# Cloudflare R2 Private Object Storage (Optional, falls back to local storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="writelynx-manuscripts"

# Storage & Privacy Retention
STORAGE_DIR="./storage"
DOCUMENT_RETENTION_DAYS=7       # Completed outputs retained for 7 days
ABANDONED_UPLOAD_HOURS=1        # Abandoned upload reservations purged after 1 hour
QUARANTINE_PURGE_HOURS=2        # Failed quarantine scratch files purged after 2 hours
OFFLINE_ONLY=true               # Local execution by default

# VIT Student Authentication (Google OAuth 2.0)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
ALLOWED_STUDENT_DOMAIN="vitstudent.ac.in"
TEST_MODE_MOCK_AUTH=1           # Set to 0 in production with real Google credentials
COOKIE_SECURE=false             # Set to true in production over HTTPS
ADMIN_EMAILS="admin@vitstudent.ac.in"
ALLOWED_ORIGINS="http://localhost:5173,https://writelynx.pages.dev,https://writelynx.in"

# Razorpay Payment Gateway (Integer Paise: 1 INR = 100 paise)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Optional LLM Inference Providers
DEFAULT_LLM_PROVIDER="no_llm"   # Options: no_llm | ollama | openai | gemini | custom
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# LibreOffice binary for headless PDF conversion
LIBREOFFICE_PATH="/usr/bin/soffice"
