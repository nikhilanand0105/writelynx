# Project Configuration
PROJECT_NAME="Manuscript Integrity Studio"
API_PREFIX="/api"
MAX_FILE_SIZE_MB=50

# LLM Inference Providers
# Options: no_llm | ollama | openai | gemini | custom
DEFAULT_LLM_PROVIDER="no_llm"

# Ollama Local Configuration (e.g. for Apple Silicon M1/M2/M3/M4)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# OpenAI or Compatible Endpoint (vLLM, LMStudio, Groq)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Custom OpenAI-compatible Endpoint
CUSTOM_ENDPOINT=""
CUSTOM_API_KEY=""

# LibreOffice binary for headless PDF conversion
LIBREOFFICE_PATH="/Applications/LibreOffice.app/Contents/MacOS/soffice"

# Strict Offline Mode (blocks remote telemetry)
OFFLINE_ONLY=true
